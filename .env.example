# Copie este ficheiro para ".env" e preencha os valores.
# NUNCA envie o ficheiro .env para o GitHub (já está no .gitignore).

# Supabase → Project Settings → API Keys
# Serve tanto o par antigo (anon / service_role, começa por eyJ...)
# como o novo (sb_publishable_... / sb_secret_...).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...chave-publica-anon...
SUPABASE_SERVICE_KEY=eyJhbGciOi...chave-secreta-service_role...

# Endereço público do site (usado na pré-visualização do LinkedIn)
SITE_URL=https://seu-portfolio.onrender.com

# Palavra-passe da página admin.php (escolha uma forte)
ADMIN_PASSWORD=mude-esta-palavra-passe
